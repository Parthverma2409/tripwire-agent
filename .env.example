# Tripwire configuration. Copy to .env (the launchers do this for you) and fill in
# only what you use. .env is git-ignored; never commit it.
# Step-by-step instructions for every value: docs/CONNECT.md

# -- Mode --------------------------------------------------------------------
# demo = sample emails and a practice calendar. live = your connected accounts.
# Connecting Google switches to live automatically; you can also flip it in the app.
BSYNC_MODE=demo
BSYNC_TIMEZONE=Asia/Kolkata
# Optional quiet hours: questions are held outside this window (e.g. 07:00-23:00).
BSYNC_ACTIVE_WINDOW=
BSYNC_POLL_MINUTES=5
BSYNC_ALARM_MINUTES=60

# -- Google Calendar + Gmail (docs/CONNECT.md, step 1) ------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Which calendar to write to ("primary" is your main one).
BSYNC_CALENDAR_ID=primary
# Optional Gmail search to narrow what is read, e.g. label:bookings newer_than:30d
BSYNC_GMAIL_QUERY=

# -- Any other inbox over IMAP (docs/CONNECT.md, step 3) ----------------------
# Yahoo: imap.mail.yahoo.com   Zoho: imap.zoho.in   iCloud: imap.mail.me.com   Fastmail: imap.fastmail.com
# (Personal Outlook.com no longer accepts app passwords over IMAP -- forward its
#  booking mail to Gmail instead; see docs/CONNECT.md.)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
# An app password, not your normal password.
IMAP_PASSWORD=

# -- Telegram approvals (docs/CONNECT.md, step 4) -----------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -- Local AI for unusual emails (docs/CONNECT.md, step 5) --------------------
# Leave OLLAMA_HOST empty to use the built-in rules only.
OLLAMA_HOST=
OLLAMA_MODEL=qwen2.5:7b-instruct

# -- Local voice (docs/CONNECT.md, step 6) ------------------------------------
# e.g. base.en. Needs: pip install faster-whisper. Empty = browser speech.
WHISPER_MODEL=

# -- Notifications (docs/CONNECT.md, step 9) ------------------------------------
# A message (Telegram, desktop) every time the calendar changes. Also in Settings.
BSYNC_NOTIFY_CHANGES=true

# -- Swiggy Dineout (docs/CONNECT.md, step 7) ------------------------------------
# Connect Swiggy from the Connections page; these say where to look for tables.
# Both can be set in Settings instead.
SWIGGY_AREA=
SWIGGY_PIN=

# -- Advanced -----------------------------------------------------------------
# Where the app keeps its database and encrypted Google token.
# BSYNC_HOME=
# Only for machines without an OS keyring (headless Linux). Normally the key
# that encrypts your Google token is generated and kept in the OS keyring.
# BSYNC_TOKEN_PASSPHRASE=
